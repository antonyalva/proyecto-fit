# Copia este archivo a .env.local y pega los valores de tu proyecto de Supabase.
# Los encuentras en: Project Settings -> Data API (URL) y Project Settings -> API Keys.
#
# Sin estas dos variables la app funciona igual, solo que sin sincronizar:
# los datos se quedan en el navegador.
#
# La anon key está pensada para ir en el cliente y es visible en el navegador.
# Lo que protege tus datos es la política RLS de supabase/schema.sql, no ocultarla.
# La service_role key es otra cosa: esa NO va aquí ni en ningún sitio del frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
